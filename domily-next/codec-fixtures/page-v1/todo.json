{
  "schema": "domily.page/v1",
  "id": "json-todo",
  "requires": {
    "catalogs": ["@domily/native-html@^1"],
    "capabilities": ["todos.save@^1"]
  },
  "ui": {
    "type": "html.div",
    "props": {
      "className": "todo-page",
      "style": { "display": "grid", "gap": "12px" }
    },
    "children": [
      { "type": "html.text", "props": { "value": "$$literal-dollar" } }
    ]
  }
}
