{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "module": "preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    // Bundler mode
    "moduleResolution": "bundler",
    "paths": {
      "@domily/next-ast": [
        "./domily-next/ast/src/index.ts"
      ],
      "@domily/next-codec-json": [
        "./domily-next/codec-json/src/index.ts"
      ],
      "@domily/next-validator": [
        "./domily-next/validator/src/index.ts"
      ],
      "@domily/next-loader": [
        "./domily-next/loader/src/index.ts"
      ],
      "@domily/next-compiler": [
        "./domily-next/compiler/src/index.ts"
      ],
      "@domily/next-runtime": [
        "./domily-next/runtime/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": [
      "bun"
    ]
  },
  "files": [
    "./types/tsconfig.d.ts"
  ]
}
