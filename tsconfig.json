{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "module": "preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    // Bundler mode
    "moduleResolution": "bundler",
    "paths": {
      "@domily/next-ast": [
        "./packages/domily-next-ast/src/index.ts"
      ],
      "@domily/next-codec-json": [
        "./packages/domily-next-codec-json/src/index.ts"
      ],
      "@domily/next-validator": [
        "./packages/domily-next-validator/src/index.ts"
      ],
      "@domily/next-loader": [
        "./packages/domily-next-loader/src/index.ts"
      ],
      "@domily/next-compiler": [
        "./packages/domily-next-compiler/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": [
      "bun"
    ]
  },
  "files": [
    "./types/tsconfig.d.ts"
  ]
}
